{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Link together minecarts with ease!",
  "authors": [
    "vini2003",
    "Martmists",
    "melontini",
    "Flatkat"
  ],
  "contributors": [
    "GeeTransit",
    "rosellle"
  ],
  "contact": {
    "sources": "https://github.com/melontini/Linkart"
  },
  "license": "MIT",
  "icon": "assets/linkart/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.github.vini2003.linkart.Linkart"
    ]
  },
  "mixins": [
    "linkart.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft}"
  },
  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/class_1688": [
        "com/github/vini2003/linkart/api/LinkableMinecart"
      ],
      "net/minecraft/world/entity/vehicle/minecart/AbstractMinecart": [
        "com/github/vini2003/linkart/api/LinkableMinecart"
      ]
    }
  }
}